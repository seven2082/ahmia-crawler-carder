# Ahmia Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ELASTICSEARCH (Required)
# =============================================================================
# For two-server setup, point to your ES server's IP/hostname
ES_URL=https://YOUR_ES_SERVER_IP:9200/

# ES credentials (set during ES installation)
ES_USERNAME=elastic
ES_PASSWORD=your_secure_password_here

# Path to ES CA certificate (copy from ES server)
# Leave empty if using a managed service with public CA
ES_CA_CERTS=/etc/ahmia/certs/http_ca.crt

# Verify SSL certificate (True for production)
VERIFY_CERT=True

# Connection timeout in seconds
ELASTICSEARCH_TIMEOUT=60

# =============================================================================
# DJANGO (Required for production)
# =============================================================================
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-change-this

# Set to False in production
DEBUG=False

# Your domain(s), comma-separated
ALLOWED_HOSTS=ahmia.fi,www.ahmia.fi

# =============================================================================
# DATABASE (Optional - defaults to SQLite)
# =============================================================================
# Uncomment for PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/ahmia

# =============================================================================
# SECURITY (Optional)
# =============================================================================
# Salt for hashing (change in production)
SALT=your_random_salt_value

# =============================================================================
# API (Required for XenForo sync)
# =============================================================================
# API key for external systems (XenForo) to access profile data
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AHMIA_API_KEY=your-secure-api-key-here
